{
  "name": "kaku",
  "version": "0.6.0",
  "private": true,
  "description": "Learn Japanese by writing it: hiragana and katakana with stroke-checked practice.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000 -d src",
    "build": "node tools/build-artifact.mjs",
    "build:strokes": "node tools/build-strokes.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-reporter=spec \"tests/e2e/*.test.mjs\"",
    "screenshots": "node tools/smoke.mjs"
  },
  "license": "SEE LICENSE IN README.md",
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "axe-core": "4.14.0"
  }
}
